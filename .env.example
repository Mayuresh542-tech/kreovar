# Groq (server-only). An enabled provider_configs record is checked first; these are environment fallbacks.
# Keep real keys in .env.local or hosting settings, never in this example.
GROQ_API_KEY="PASTE_GROQ_API_KEY_HERE"
# Optional dedicated transcription key. When blank, transcription can use the configured Groq key.
GROQ_TRANSCRIPTION_API_KEY=
TRANSCRIPTION_PROVIDER=groq

# OpenRouter AI (NVIDIA Nemotron 3 Ultra)
OPENROUTER_API_KEY="PASTE_OPENROUTER_API_KEY_HERE"
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Google Gemini AI
GEMINI_API_KEY="PASTE_GEMINI_API_KEY_HERE"
GEMINI_MODEL="PASTE_GEMINI_MODEL_HERE"

# Whop Integration (Server-Side Secret - Never expose to client)
WHOP_API_KEY="PASTE_WHOP_API_KEY_HERE"
WHOP_WEBHOOK_SECRET="PASTE_WHOP_WEBHOOK_SECRET_HERE"
# Informational product link. Live checkout is created with account and plan IDs below.
WHOP_CHECKOUT_URL="https://whop.com/veelox-studio-0b8d/kreovar/"
WHOP_ACCOUNT_ID="PASTE_KREOVAR_WHOP_ACCOUNT_ID_HERE"
WHOP_MONTHLY_PLAN_ID="PASTE_KREOVAR_MONTHLY_PLAN_ID_HERE"
WHOP_YEARLY_PLAN_ID="PASTE_KREOVAR_YEARLY_PLAN_ID_HERE"
WHOP_RETURN_URL="https://kreovar.online/checkout/return"
WHOP_WEBHOOK_URL="https://kreovar.online/api/webhooks/whop"

# Admin Allowlist (Comma-separated admin emails)
ADMIN_EMAILS="PASTE_ADMIN_EMAILS_HERE"

# Supabase Credentials
SUPABASE_URL="PASTE_SUPABASE_URL_HERE"
SUPABASE_ANON_KEY="PASTE_SUPABASE_ANON_KEY_HERE"
SUPABASE_SERVICE_ROLE_KEY="PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE"

# Client-facing Supabase URL/Anon Key (Next.js)
NEXT_PUBLIC_SUPABASE_URL="PASTE_SUPABASE_URL_HERE"
NEXT_PUBLIC_SUPABASE_ANON_KEY="PASTE_SUPABASE_ANON_KEY_HERE"

# Server Encryption Secret for User Stored Keys
ENCRYPTION_SECRET="PASTE_32_BYTE_BASE64_SECRET_HERE"

# Voice.ai Voiceover Synthesis API Keys (comma-separated for key rotation/failover)
VOICE_AI_API_KEY="PASTE_VOICE_AI_API_KEY_HERE"
VOICE_AI_API_KEYS="PASTE_COMMA_SEPARATED_VOICE_AI_KEYS_HERE"

# Server-only Pixabay API key for animation videos. Public API has no SFX endpoint.
PIXABAY_API_KEY=

# Set false on hosts without the FFmpeg finishing service; defaults to enabled locally.
NEXT_PUBLIC_SERVER_MP4_ENABLED=

# Dodo sandbox only. Keep real Whop subscriptions and allowances separate.
DODO_SANDBOX_ENABLED=false
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_MONTHLY_PRODUCT_ID=
DODO_YEARLY_PRODUCT_ID=
DODO_RETURN_ORIGIN=http://127.0.0.1:3100

# Optional legacy editor credential; Groq is primary by default.
# Only set EDITOR_AI_PRIMARY_PROVIDER=radox when explicitly restoring a working legacy connection.
EDITOR_AI_PRIMARY_PROVIDER=groq
RADOX_API_KEY=
# Optional stock search and deployment origin
PEXELS_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Optional local media executables; blank uses executable lookup
FFMPEG_PATH=
FFPROBE_PATH=
# Experimental reference editor; keep disabled until migration/services are ready
REFERENCE_PRESETS_ENABLED=false
NEXT_PUBLIC_REFERENCE_PRESETS_ENABLED=false
REFERENCE_PRESET_LOCAL_STORE=false
REFERENCE_PRESET_INTERNAL_ORIGIN=http://localhost:3000
